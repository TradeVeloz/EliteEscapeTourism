# Database
DATABASE_URL="postgresql://eliteescape:eliteescape@localhost:5432/eliteescape"

# Auth
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Supabase (optional, if used instead of self-hosted Postgres auth)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AI travel planner — optional. Without this, /api/v1/ai/* routes and the
# AI Travel Planner UI still work, using a deterministic rule-based matcher.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Cache / rate limiting — not yet consumed by the app (rate limiting is
# in-memory today, see src/lib/rate-limit.ts); provisioned for the
# multi-instance follow-up.
REDIS_URL="redis://localhost:6379"

# App
FRONTEND_URL="http://localhost:3000"

# Monitoring
SENTRY_DSN=""

# Maps & travel data integrations
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""
BOOKING_COM_API_KEY=""

# Voice AI
ELEVENLABS_API_KEY=""
